<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.reidar.bunkerkartet-backup-pull</string>
<key>ProgramArguments</key><array>
<string>/opt/homebrew/bin/python3</string>
<string>__RUNTIME_ROOT__/bin/pull_encrypted_backup.py</string>
<string>--config</string><string>__RUNTIME_ROOT__/pull.json</string>
</array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>StartInterval</key><integer>3600</integer>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>__RUNTIME_ROOT__/logs/pull.log</string>
<key>StandardErrorPath</key><string>__RUNTIME_ROOT__/logs/pull-error.log</string>
</dict></plist>
