services:
  bunkerkartet:
    image: {{ bunkerkartet_image_repository }}@{{ bunkerkartet_image_digest }}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      BUNKERKARTET_DATA_DIR: /app/data
      APP_VERSION: {{ bunkerkartet_image_tag }}
    ports:
      - "127.0.0.1:8000:8000"
    volumes:
      - bunkerkartet-data:/app/data
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s

volumes:
  bunkerkartet-data:
    name: bunkerkartet-data
