      "display_name": "Junkers Ju 88 A – Jonsvatnet (markør 413)",
      "kind_label": "Flyvrak / historisk havaristed",
      "reviewed_at": "2026-09-15",
      "sources": [
        {
          "id": "s1",
          "title": "KrigsKart: Jonsvatnet, Trondheim, 3",
          "url": "https://w.krigskart.no/index.php?title=Jonsvatnet,_Trondheim,_3&oldid=6380",
          "accessed_at": "2026-09-15"
        },
        {
          "id": "s2",
          "title": "Trondheim kommune: Jonsvatnet",
          "url": "https://trondheim.kommune.no/tema/veg-vann-og-avlop/vann-og-avlop/drikkevann/jonsvatnet/",
          "accessed_at": "2026-09-15"
        },
        {
          "id": "s3",
          "title": "Flyvrak.info: Ju 88 A-1 Jonsvatnet",
          "url": "https://www.flyvrak.info/jonsvatnet2.html",
          "accessed_at": "2026-09-15"
        }
      ],
      "claims": [
        {
          "id": "about",
          "section": "about",
          "text": "KrigsKart knytter markør 413 til et Junkers Ju 88 A som gikk gjennom smeltende is på Jonsvatnet. Kilden oppgir 21. april 1940; vannet ble brukt som flyplass tidlig i krigen.",
          "certainty": "source_supported",
          "source_ids": [
            "s1"
          ]
        },
        {
          "id": "current",
          "section": "current",
          "text": "Nåværende vrakstatus for akkurat denne markøren er ikke avklart. Dokumentasjon om Ju 88 A-1 U4+TK og heving i 2004 kan ikke uten videre overføres til markør 413.",
          "certainty": "uncertain",
          "source_ids": [
            "s1",
            "s3"
          ]
        },
        {
          "id": "physical_access",
          "section": "physical_access",
          "text": "Kilden beskriver et fly som sank i vannet, ikke et landbasert besøksobjekt. Det er ikke dokumentert hva som eventuelt ligger igjen ved markøren.",
          "certainty": "source_supported",
          "source_ids": [
            "s1",
            "s3"
          ]
        },
        {
          "id": "access_rules",
          "section": "access_rules",
          "text": "Dykking i Jonsvatnet er forbudt. Kommunen oppgir også forbud mot bading; vannet er drikkevannskilde.",
          "certainty": "source_supported",
          "source_ids": [
            "s2"
          ]
        },
        {
          "id": "uncertainty",
          "section": "uncertainty",
          "text": "Flyets individuelle identitet, samsvar med hevede fly og eventuelle gjenværende deler må avklares. Kartpunktet er ikke en verifisert vrakposisjon.",
          "certainty": "uncertain",
          "source_ids": [
            "s1",
            "s3"
          ]
        }
      ]
    },
    {
      "external_key": "krigskart:2644",
      "display_name": "Dora I og Dora II",
