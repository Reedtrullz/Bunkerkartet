      "reviewed_at": "2026-09-15",
      "sources": [
        {
          "id": "s1",
          "title": "Store norske leksikon: Dora I og II",
          "url": "https://snl.no/Dora_I_og_II",
          "accessed_at": "2026-09-15"
        },
        {
          "id": "s2",
          "title": "Arkivsenteret: Besøke oss",
          "url": "https://arkivsenteret.no/besoksinformasjon/",
          "accessed_at": "2026-09-15"
        }
      ],
      "claims": [
        {
          "id": "about",
          "section": "about",
          "text": "To ubåtbunkere på Nyhavna, oppført av den tyske okkupasjonsmakten. Dora I ble ferdig i juli 1943; Dora II var uferdig ved krigens slutt.",
          "certainty": "source_supported",
          "source_ids": [
            "s1"
          ]
        },
        {
          "id": "current",
          "section": "current",
          "text": "Bunkerne står fortsatt og har fått sivile bruksområder. Arkivsenteret holder til ved Dora I, med arkivsamlinger inne i bunkeren.",
          "certainty": "source_supported",
          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "physical_access",
          "section": "physical_access",
          "text": "Dette er to separate bygninger. Arkivsenterets besøksadresse er Maskinistgata 1; ett kartpunkt dekker ikke begge bunkernes innganger.",
          "certainty": "source_supported",
          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "access_rules",
          "section": "access_rules",
          "text": "Arkivsenterets besøksordning gjelder deres publikumstilbud. Den dokumenterer ikke fri adgang til resten av bunkerne eller verkstedsområdene.",
          "certainty": "uncertain",
          "source_ids": [
            "s2"
          ]
        },
        {
          "id": "uncertainty",
          "section": "uncertainty",
          "text": "Tilgangen må avklares for den konkrete bygningen og virksomheten. Det samlede kartpunktet er ikke en kontrollert inngang.",
          "certainty": "uncertain",
          "source_ids": [
            "s1",
            "s2"
          ]
        }
      ]
    },
    {
