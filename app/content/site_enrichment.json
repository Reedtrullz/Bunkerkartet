      "claims": [
        {
          "id": "about",
          "section": "about",
          "text": "Den tyske okkupasjonsmakten bygde en permanent flyplass på Lade i 1940, med rullebane, hangarer og takseveier. Anlegget hadde også nærforsvarsstillinger.",
