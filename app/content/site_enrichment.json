          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "uncertainty",
          "section": "uncertainty",
          "text": "Hvilke fysiske rester som fortsatt er synlige, og hvilke som kan besøkes lovlig, må dokumenteres hver for seg.",
