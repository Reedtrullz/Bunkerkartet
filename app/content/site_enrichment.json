      "claims": [
        {
          "id": "about",
          "section": "about",
          "text": "Under okkupasjonen ble Munkholmen brukt til forsvar av blant annet ubåtbasen Dora. Tyskerne bygde om deler av festningen og opprettet luftvernstillinger.",
          "certainty": "source_supported",
          "source_ids": [
            "s1"
          ]
        },
        {
          "id": "current",
          "section": "current",
          "text": "WikiStrinda beskriver bevarte betongfundamenter, en tilbakeført kanon og en optisk avstandsmåler. Dette er kildeopplysninger, ikke en fersk feltkontroll.",
          "certainty": "source_supported",
          "source_ids": [
            "s1"
          ]
        },
        {
          "id": "physical_access",
          "section": "physical_access",
          "text": "Anlegget ligger på en øy. Ordinært besøk skjer med sesongbåt; kontroller avgangene hos operatøren.",
          "certainty": "source_supported",
          "source_ids": [
            "s2",
            "s3"
          ]
        },
        {
          "id": "access_rules",
          "section": "access_rules",
          "text": "Besøks- og båttilbudet er sesongbasert. Operatørens gjeldende informasjon må sjekkes før turen.",
          "certainty": "source_supported",
          "source_ids": [
            "s2"
          ]
        },
        {
          "id": "uncertainty",
          "section": "uncertainty",
          "text": "Tilgangen til hvert enkelt militært rom eller anlegg er ikke verifisert. Kartmarkøren er ikke et godkjent landings- eller inngangspunkt.",
          "certainty": "uncertain",
          "source_ids": [
            "s1",
            "s2"
          ]
        }
