        }
      ],
      "claims": [
        {
          "id": "about",
          "section": "about",
          "text": "Tyskerne rev Gråkallhytta i 1942 og anla en lytte- og vaktstasjon på området. Fjellet fikk senere militære tele- og datainstallasjoner.",
          "certainty": "source_supported",
          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "current",
          "section": "current",
          "text": "WikiStrinda omtaler både krigsanlegget og senere radarinstallasjoner. Disse må ikke behandles som ett og samme objekt.",
          "certainty": "uncertain",
          "source_ids": [
            "s2"
          ]
        },
        {
          "id": "physical_access",
          "section": "physical_access",
          "text": "Lokaliteten ligger på Gråkallen. Kildene gir ikke en kontrollert inngang til den tidligere vaktstasjonen.",
          "certainty": "source_supported",
          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "access_rules",
          "section": "access_rules",
          "text": "Dagens adgang til militære bygninger og inngjerdede områder er ikke dokumentert i de gjennomgåtte kildene.",
          "certainty": "uncertain",
          "source_ids": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "uncertainty",
          "section": "uncertainty",
          "text": "Hvilke synlige rester som tilhører krigstiden, og den konkrete adkomsten, trenger nærmere dokumentasjon.",
          "certainty": "uncertain",
          "source_ids": [
            "s2"
          ]
        }
      ]
    },
